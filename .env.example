# Variables para docker compose (copiar a .env y cambiar los valores en ambientes compartidos).
RABBITMQ_USERNAME=pedidos360
RABBITMQ_PASSWORD=pedidos360
INVENTARIO_API_KEY=local-dev-inventory-key
PEDIDOS_API_KEY=local-dev-orders-key
ENVIOS_API_KEY=local-dev-shipping-key
RABBIT_ADMIN_API_KEY=local-dev-rabbit-admin-key
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# EP5 - Kafka
KAFKA_ADMIN_API_KEY=local-dev-kafka-admin-key
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=pedidos360
# IP o DNS publico del host para el listener EXTERNAL de los brokers (localhost en desarrollo).
KAFKA_EXTERNAL_HOST=localhost
